{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Project",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "windows": {
                "args": [
                    "-std=c++17",
                    "-g",
                    "-I${workspaceFolder}",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}.exe"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}

